{
  "name": "nium-wiki",
  "version": "0.0.11",
  "description": "Professional-grade project Wiki generator (aligned with the Karpathy LLM Wiki compile-not-retrieve pattern), powered by AI coding tools",
  "main": "dist/serve.js",
  "bin": {
    "nium-wiki": "dist/serve.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && chmod +x dist/serve.js && node scripts/copy-vendor.mjs",
    "bundle": "ncc build src/cli.ts -o skills/nium-wiki/scripts --minify && node scripts/inject-version.mjs && node scripts/post-bundle.mjs",
    "start": "node dist/serve.js",
    "dev": "ts-node src/cli.ts"
  },
  "keywords": [
    "wiki",
    "documentation",
    "generator",
    "mermaid",
    "ai",
    "code-analysis",
    "cross-linked",
    "skill",
    "claude-code",
    "llm-wiki",
    "karpathy",
    "knowledge-base",
    "compiled-documentation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niuma996/nium-wiki.git"
  },
  "bugs": {
    "url": "https://github.com/niuma996/nium-wiki/issues"
  },
  "homepage": "https://github.com/niuma996/nium-wiki#readme",
  "files": [
    "dist/"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.4",
    "docsify": "^4.13.1",
    "docsify-mermaid": "^2.0.1",
    "mermaid": "^10.9.0",
    "prismjs": "^1.29.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
